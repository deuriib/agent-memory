# Dependencies & build output
node_modules/
dist/
target/
*.tgz

# HelixDB instance state — regenerated by `helix start`, never committed
.helix/

# Secrets & local env
.env
.env.*
!.env.example

# Logs & OS noise
*.log
# ...except gate evidence artifacts — REQ→artifact trace must be committable
# (root cause of QA-04/05: *.log silently excluded evidence/ at add time)
!docs/specs/**/evidence/*.log
.DS_Store
